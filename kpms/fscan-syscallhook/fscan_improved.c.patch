// ============================================================
// 改进版本 1: 使用 __va() 直接访问（推荐）
// ============================================================

static size_t read_physical_address(phys_addr_t pa, void __user *buffer, size_t size)
{
    void *vaddr;
    unsigned long pfn = __phys_to_pfn(pa);
    
    // 验证物理地址
    if (!pfn_valid(pfn)) {
        logv("Invalid PFN for pa=0x%llx\n", pa);
        return 0;
    }
    
    // ✅ 改进：直接使用 __va() 转换到内核虚拟地址
    // ARM64 内核的线性映射区域已经映射了所有物理内存
    vaddr = __va(pa);
    
    // 检查地址是否在有效范围内
    // 简单检查：确保不是 NULL 且在内核地址空间
    if (!vaddr || (unsigned long)vaddr < page_offset1) {
        logv("Invalid kernel virtual address: 0x%lx\n", (unsigned long)vaddr);
        return 0;
    }
    
    // ✅ 直接复制数据，无需 ioremap！
    // 这样完全隐蔽，不会留下任何痕迹
    if (compat_copy_to_user(buffer, vaddr, size) != 0) {
        logv("Failed to copy to user: vaddr=0x%lx, size=%zu\n", (unsigned long)vaddr, size);
        return 0;
    }
    
    logv("Successfully read from vaddr=0x%lx (pa=0x%llx), size=%zu\n", 
         (unsigned long)vaddr, pa, size);
    
    return size;
}

